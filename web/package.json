{
  "name": "f1db-web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Browser front end for Lap Ledger. SQLite compiled to WebAssembly, in a worker, querying f1.db directly — no server, no API.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "assets": "node scripts/prepare-assets.js",
    "parquet": "node scripts/parquet-bundle.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && npm run parquet && vite build && npm run prerender",
    "preview": "vite preview",
    "test": "npm run test:units && node test/smoke.mjs",
    "prerender": "node scripts/prerender.js",
    "test:units": "node --test test/units.mjs test/conventions.mjs",
    "test:page": "node test/smoke.mjs --quiet --only",
    "test:browser": "node test/smoke.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.62.1",
    "vite": "^8.2.2"
  }
}
